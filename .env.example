# === Mode ===
# paper = local simulation (safe default)
# practice = broker demo (Exness MT5 demo server)
# live = real money
TRADING_MODE=paper

# paper | mt5 | oanda
BROKER=paper

# === Exness via MetaTrader 5 ===
# 1) Install MT5 terminal and log into Exness once
# 2) Enable Algo Trading in MT5 (toolbar button)
# 3) Tools -> Options -> Expert Advisors:
#    - Allow algorithmic trading
# 4) Fill these from your Exness MT5 account:
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial8
# Optional full path if multiple terminals installed:
# MT5_PATH=C:\Program Files\MetaTrader 5 EXNESS\terminal64.exe
# Symbol map (Exness often uses m suffix). Adjust after checking Market Watch:
MT5_SYMBOL_MAP=EUR_USD:EURUSDm,GBP_USD:GBPUSDm,XAU_USD:XAUUSDm
MT5_MAGIC=260727
MT5_DEVIATION=20

# === OANDA (optional) ===
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# === AI (optional) ===
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# === Risk ===
RISK_PER_TRADE_PCT=0.75
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DRAWDOWN_PCT=8.0
MAX_OPEN_TRADES=2
MAX_TRADES_PER_DAY=8
MIN_RR_RATIO=1.5
COOLDOWN_LOSSES=3
COOLDOWN_MINUTES=60

# === Strategy ===
INSTRUMENTS=EUR_USD,GBP_USD,XAU_USD
TIMEFRAME=M15
LOOKBACK_CANDLES=200
TRADING_SESSIONS=london,newyork
STARTING_EQUITY=10000

# === Telegram (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOOP_SECONDS=60
LOG_LEVEL=INFO
